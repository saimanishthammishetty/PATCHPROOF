# PATCHPROOF Environment Configuration
# ==============================================================================
# GitHub Authentication Configuration
# ==============================================================================
# To create real GitHub Draft Pull Requests on live repositories:
# Provide a GitHub Personal Access Token (classic or fine-grained) or GitHub App token.
#
# Required Permissions for Fine-Grained Personal Access Tokens:
#   - Repository Permissions -> Contents: Read and Write
#   - Repository Permissions -> Pull requests: Read and Write
#   - Repository Permissions -> Metadata: Read-only (mandatory)
#
# Required Scopes for Classic Personal Access Tokens:
#   - 'repo' (Full control of private repositories) or 'public_repo' (for public repos only)
#
# Safety Guarantee:
#   - PATCHPROOF operates exclusively in DRAFT mode.
#   - NEVER merges pull requests automatically (NEVER_MERGE=true is hard-enforced).
#   - Tokens are kept strictly in backend memory and never exposed to the frontend/UI.
#
# If GITHUB_TOKEN is omitted or empty, PATCHPROOF operates in transparent
# Dry-Run / Simulation mode without making live GitHub write calls.
GITHUB_TOKEN=
PATCHPROOF_GITHUB_TOKEN=

# Host and Port Configuration
HOST=127.0.0.1
PORT=8000

# Security Guard (Permanent & Non-Negotiable)
NEVER_MERGE=true

# Offline Mode (Optional: set to 1 to run with local advisory & KEV caches)
PATCHPROOF_OFFLINE=0

